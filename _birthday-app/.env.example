# Public browser configuration only
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Backend only: set using supabase secrets set --env-file .env.backend
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# META_GRAPH_VERSION=v23.0
# CRON_SECRET=generate-a-random-64-character-secret
# ALLOWED_ORIGIN=https://your-panel.example.com
