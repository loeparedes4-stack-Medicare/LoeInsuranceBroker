# Copy to .env.backend (ignored by Git). NEVER use a VITE_ prefix here.
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_SYSTEM_USER_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
META_GRAPH_VERSION=v23.0
CRON_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
ALLOWED_ORIGIN=http://127.0.0.1:5173

# PIN login: SHA-256(SALT + ":" + PIN); never publish the PIN
PANEL_PIN_SALT=GENERATE_RANDOM_SALT
PANEL_PIN_HASH=COMPUTE_SHA256_HASH
